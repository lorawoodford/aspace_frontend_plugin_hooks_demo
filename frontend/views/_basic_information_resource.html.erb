<div class="form-group w-100 row">
  <label class="control-label text-right col-sm-2" for="plugin_hooks_example_level_display">
    plugin_hooks_example: Level, spelled out
  </label>
  <div class="col-sm-9">
    <input
      type="text"
      id="plugin_hooks_example_level_display"
      class="form-control"
      disabled
      value="<%= I18n.t("enumerations.archival_record_level.#{record['level']}", :default => record['level']) %>"
    />
    <p class="text-muted small mb-0">
      Disabled -- this field isn't real. Even enabled, this hook has no way
      to save what's typed here; that needs real backend plugin work.
    </p>
  </div>
</div>
